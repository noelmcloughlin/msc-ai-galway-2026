# LOKF knowledge-bundle recipes for MSc Artificial Intelligence.
#
# The `lokf` toolkit is a Python sidecar (see pyproject.toml); these recipes
# drive it against the knowledge/ bundle. Run `just --list` to see them.

bundle := "knowledge"
schema := "msc-ai.yaml"

# List available recipes
default:
    @just --list

# Install the lokf sidecar toolkit into a local .venv
lokf-install:
    uv sync

# Assemble and validate the knowledge bundle against msc-ai.yaml, which extends
# the LOKF vocabulary into this domain: it imports the pinned lokf.yaml and adds
# the classes and keys a degree programme needs. convert/serve/query have no
# --schema flag and resolve the core schema via that same local copy.
lokf-validate: lokf-check-pin
    uv run lokf validate --schema {{ schema }} {{ bundle }}

# Confirm the pinned core schema is the version this sidecar's toolkit floor
# declares. A stale lokf.yaml still validates - against a vocabulary the
# toolkit has moved past - so nothing else catches it. The same check runs in
# knowledge-registrar.yaml on every .lokf/** pull request.
lokf-check-pin:
    #!/usr/bin/env bash
    set -euo pipefail
    pinned="$(grep -m1 '^version:' lokf.yaml | awk '{print $2}')"
    floor="$(grep -o 'lokf\[build\]>=[0-9][0-9.]*' pyproject.toml | head -1 | sed 's/.*>=//')"
    if [[ "$pinned" == "$floor" ]]; then
      echo "OK - pinned lokf.yaml $pinned matches the lokf[build] floor"
    else
      echo "FAIL - lokf.yaml is pinned at $pinned but pyproject.toml floors lokf[build] at $floor" >&2
      echo "       Refresh the pinned copy in the same change as the bump; the recipe is in" >&2
      echo "       lokf-agent-skills, skills/lokf-librarian/references/domain-schema.md." >&2
      exit 1
    fi

# Project the bundle (or a concept file) to RDF (Turtle) on stdout
lokf-convert FILE=bundle:
    uv run lokf convert --format ttl {{ FILE }}

# Serve the bundle locally: SPARQL endpoint + live graph explorer
lokf-serve:
    uv run lokf serve {{ bundle }}

# Audit: every typed-relation target must resolve to a concept in the bundle.
# lokf validate only checks frontmatter/bundle shape, not cross-concept
# references, so a fabricated or stale target passes it silently - this
# closes that gap with the same SPARQL interface `lokf-serve` exposes.
lokf-check-refs:
    #!/usr/bin/env bash
    set -euo pipefail
    q='SELECT DISTINCT ?target WHERE { ?s ?p ?target . FILTER(?p IN (dcterms:isPartOf, schema:hasPart, dcterms:references, dcterms:requires, prov:wasDerivedFrom, schema:about, schema:sameAs, dcterms:relation, rdfs:isDefinedBy, dcterms:source)) FILTER(isIRI(?target)) FILTER NOT EXISTS { ?target a ?anytype } }'
    dangling="$(uv run lokf query {{ bundle }} "$q" --format csv | tail -n +2)"
    if [ -z "$dangling" ]; then
      echo "OK - every typed-relation target resolves to a concept in the bundle."
    else
      echo "FAIL - relation target(s) with no matching concept in the bundle:"
      echo "$dangling"
      exit 1
    fi

# The knowledge_bundle doorway: the bundle under an ordinary, visible name at the
# host root, for folder pickers and file managers that hide dot-folders and for
# Obsidian's "Open folder as vault" (open the link itself, never the host root).
# Git carries the link; a sync service such as OneDrive does not, so a machine
# may need it recreated. POSIX only - on Windows: mklink /J knowledge_bundle .lokf\knowledge

# Create (or recreate) the knowledge_bundle -> .lokf/knowledge doorway link at the host root
lokf-link:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -L knowledge ]; then echo "knowledge is itself a link onto $(readlink knowledge) - that folder is already the visible name; nothing to do"; exit 0; fi
    if [ ! -d knowledge ]; then echo "no knowledge/ folder here to link to" >&2; exit 1; fi
    if [ -L ../knowledge_bundle ]; then
      if [ "$(readlink ../knowledge_bundle)" = ".lokf/knowledge" ]; then echo "knowledge_bundle already present - nothing to link"; exit 0; fi
      echo "../knowledge_bundle is a link elsewhere ($(readlink ../knowledge_bundle)) - remove it and re-run" >&2; exit 1
    fi
    if [ -e ../knowledge_bundle ]; then echo "../knowledge_bundle exists and is not a link - leaving it alone" >&2; exit 1; fi
    ln -s .lokf/knowledge ../knowledge_bundle && echo "linked knowledge_bundle -> .lokf/knowledge"

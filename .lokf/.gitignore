# Python sidecar artifacts (do not commit)
.venv/
__pycache__/
*.pyc
lokf-tables/

# Obsidian state written into knowledge/ when the bundle is opened as a vault
# of its own - the exhibition vault, reached through the root knowledge_bundle
# link. This showcase commits that vault's plugin installs (community-plugins.json
# and the two LOKF plugins, so a clone opens ready to curate) and ignores
# everything else Obsidian writes there: workspace state, appearance, caches.
knowledge/.obsidian/*
!knowledge/.obsidian/community-plugins.json
!knowledge/.obsidian/plugins/
knowledge/.obsidian/plugins/*
!knowledge/.obsidian/plugins/lokf-registrar/
!knowledge/.obsidian/plugins/lokf-curator/
